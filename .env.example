# Zoteus configuration — copy to .env and fill in. NEVER commit your real .env.

# --- Cloud Web API (required for writes / sync / group libraries) ---
# Create a key at https://www.zotero.org/settings/keys
ZOTERO_API_KEY=
# Zotero 10+ desktop local-API key (optional; when unset, Zoteus asks Zotero once via its grant dialog)
ZOTEUS_LOCAL_API_KEY=

# Optional: pin a library explicitly. If omitted, Zoteus resolves your
# personal library (and accessible groups) automatically from the key.
# ZOTERO_LIBRARY_ID=
# ZOTERO_LIBRARY_TYPE=user   # user | group

# --- Zotero desktop local API (fast, key-free reads + full PDFs) ---
ZOTEUS_LOCAL=auto            # auto | on | off
# ZOTERO_LOCAL_PORT=23119
# The Zotero desktop app's OWN data directory (not ZOTEUS_DATA_DIR below). Its
# storage/<attachment key>/ folders hold the files, which Zoteus reads directly when it
# shares the machine with Zotero and the app is not running. Defaults to ~/Zotero; set
# this only if you moved Zotero's data directory.
# ZOTERO_DATA_DIR=

# --- Citation pipeline (optional external service) ---
# A Zotero translation-server for add-by-DOI/ISBN/PMID/arXiv and add-by-URL.
ZOTEUS_TRANSLATION_SERVER_URL=http://127.0.0.1:1969

# --- Semantic search ---
ZOTEUS_EMBEDDINGS=local      # local | openai | gemini | off
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# `local` needs @huggingface/transformers, which is NOT bundled (the resolved dependency
# tree, onnxruntime's native binaries included, is about 700 MB). Install it, or point this
# at an install that lives elsewhere. Desktop-extension (.mcpb) users need this: the bundle
# resolves modules only from inside itself, and Claude Desktop runs the server on its own
# built-in Node, so `npm i -g` under a version manager is the wrong install. Give the
# package a directory of its own instead:
#   mkdir -p ~/.zoteus-deps && cd ~/.zoteus-deps && npm init -y && npm i @huggingface/transformers
# then point this at ~/.zoteus-deps/node_modules (the package directory itself, or an npm
# prefix whose modules live under lib/node_modules, work too).
# ZOTEUS_TRANSFORMERS_PATH=

# Embedding model for whichever provider is active, local included. Unset keeps that
# provider's default: Xenova/all-MiniLM-L6-v2 (local), text-embedding-3-small (openai),
# text-embedding-004 (gemini). Under local it takes any transformers.js feature-extraction
# model, which is how a German or otherwise multilingual library gets an embedder trained for
# it: Xenova/multilingual-e5-small, same 384 dimensions, weights downloaded once into
# ZOTEUS_DATA_DIR/models. Switching models makes the stored vectors unusable, so the next
# build re-embeds the library (Zoteus says so and drops them rather than ranking against a
# foreign vector space).
# ZOTEUS_EMBEDDING_MODEL=

# Whether local embedding inputs carry the E5 family's markers: "query: " in front of a query,
# "passage: " in front of an indexed passage. auto (default) applies them when the model id has
# e5 as a segment and never otherwise; off never applies them; e5 applies them whatever the
# model is called. E5 models retrieve noticeably worse without them.
# ZOTEUS_EMBEDDING_PREFIXES=auto

# Weight precision for the local model. Unset = fp32, the full-precision graph. q8 loads the
# quantized one instead: Xenova/multilingual-e5-small drops from 465 MB on disk to 129 MB, and
# Xenova/all-MiniLM-L6-v2 from 87 MB to 23 MB, at a small ranking cost. A dtype names a file the
# repository actually publishes, so a repo without a quantized graph 404s rather than converting.
# Above fp32 the precision joins the vector identity (local:<model>@q8), so changing it costs one
# rebuild; fp32 stays unsuffixed and declares no existing index stale.
# ZOTEUS_EMBEDDING_DTYPE=fp32

# How a local model's token vectors become one passage vector. auto (default) looks the model up
# in Zoteus's curated table and uses the pooling it was trained with, falling back to mean for an
# id the table does not know. Set mean or cls only if you have read the model's own
# 1_Pooling/config.json: the wrong choice returns a subtly worse vector with no error. Anything
# other than the model's trained pooling is a different vector space and joins the identity.
# ZOTEUS_EMBEDDING_POOLING=auto

# Passages per embedding call: one API request, or one local pipeline call. Unset = 32 per
# build request. Lower it when a provider rejects a batch as too large (OpenAI answers 400
# above 300K tokens per request, which full-text passages reach much sooner than metadata).
# ZOTEUS_EMBED_BATCH_SIZE=32
# Pause between those calls, in milliseconds. 0 (default) only yields to the event loop;
# a positive value paces requests to stay under a provider's tokens-per-minute limit.
# ZOTEUS_EMBED_BATCH_DELAY_MS=0

# Also index the body text of attachments (not just titles/abstracts), so a search can
# match a claim buried in a PDF. Off by default: it is roughly 9x the passages, index
# size and embedding time. Per build, pass zotero_index fulltext:true instead.
# ZOTEUS_INDEX_FULLTEXT=false
# ZOTEUS_INDEX_FULLTEXT_MAX_CHARS=40000   # per item; 0 = no cap

# Concurrent attachment full-text fetches during a build. Unset, it depends on which Zotero
# API is serving the crawl: 2 for the desktop app, 4 for the cloud Web API. The desktop app
# is one process with no rate limiter, and four continuous body reads were enough to stop it
# answering on port 23119 at all, which drops the whole session onto the Web API. Set this
# only if you have measured your own machine: a crawl already backs off to one read at a
# time by itself once Zotero stops answering.
# ZOTEUS_INDEX_FULLTEXT_CONCURRENCY=2

# Max top-level items one index build will crawl. Raise it for a library bigger than the
# default; zotero_index limit: can lower it per build, never raise it.
# ZOTEUS_INDEX_MAX_ITEMS=5000

# Where the index is stored: auto (default) uses SQLite/FTS5 through Node's built-in
# node:sqlite when the runtime has it (Node 22.13+) and the legacy JSON file otherwise;
# sqlite requires it and refuses to start without it; memory forces the JSON file, which
# cannot hold much past 250k passages (JSON.stringify tops out around 512 MB). An existing
# search-index.json is imported on the first SQLite open and left in place.
# ZOTEUS_INDEX_BACKEND=auto

# Two-stage vector search on the SQLite backend: a binary code per vector (one sign bit per
# dimension, centred on the corpus mean) is scanned first, then the exact cosine rescores
# the candidates it found. Every score returned stays exact; the pool is what decides how
# much of the exact ranking is recovered. Set ZOTEUS_INDEX_ANN=false to scan every vector.
# ZOTEUS_INDEX_ANN=true
# ZOTEUS_INDEX_ANN_OVERSAMPLE=16          # candidates rescored per hit asked for
# ZOTEUS_INDEX_ANN_MIN_CANDIDATES=500     # floor on that pool

# --- Scholarly-context graph ---
ZOTEUS_SCHOLAR_PROVIDERS=openalex   # comma list: openalex,crossref,semanticscholar
# SEMANTIC_SCHOLAR_API_KEY=

# Polite-pool contact for OpenAlex / Crossref / NCBI.
ZOTEUS_CONTACT_EMAIL=

# --- Safety ---
# Must be true to expose the PERMANENT delete tool. Trash (reversible) is always available.
ZOTEUS_ALLOW_DELETE=false

# Expose ONLY read tools (no library mutations). Recommended when serving over a
# public/tunnelled HTTP endpoint (e.g. a claude.ai connector).
ZOTEUS_READ_ONLY=false

# --- Remote OAuth (claude.ai web custom connector) — see docs/remote-oauth.md ---
# Turn the HTTP /mcp endpoint into an OAuth 2.1 + PKCE protected resource.
ZOTEUS_OAUTH_ENABLED=false
# Public HTTPS origin claude.ai will reach (no trailing slash). Required when enabled.
# ZOTEUS_PUBLIC_URL=https://zoteus.example.com
# Operator passcode that gates the consent step (>= 12 chars). Required when enabled.
# Generate one with: openssl rand -base64 24
# ZOTEUS_OAUTH_PASSCODE=
# Optional token lifetimes in seconds (access 1h, refresh 30d):
# ZOTEUS_OAUTH_ACCESS_TTL=3600
# ZOTEUS_OAUTH_REFRESH_TTL=2592000
# Optional extra Host values for DNS-rebinding protection (if a proxy rewrites Host):
# ZOTEUS_ALLOWED_HOSTS=
# Override the guard that forbids binding a non-loopback host WITHOUT OAuth (trusted nets only):
# ZOTEUS_ALLOW_INSECURE_HTTP=false

# --- Multi-tenant (per-user Zotero accounts) — see docs/remote-oauth.md ---
# passcode (default, single operator key) | zotero (each user logs into their own Zotero)
ZOTEUS_OAUTH_MODE=passcode
# Register a Zotero app at https://www.zotero.org/oauth/apps (callback:
# https://<your-host>/oauth/zotero/callback). Required when mode=zotero.
# ZOTERO_OAUTH_CLIENT_KEY=
# ZOTERO_OAUTH_CLIENT_SECRET=
# Persist registered clients / tokens / per-user keys across restarts: memory (default) | file
ZOTEUS_OAUTH_STORE=memory
# AES-256-GCM key material to encrypt stored Zotero keys at rest; required when store=file.
# Generate with: openssl rand -base64 32
# ZOTEUS_OAUTH_TOKEN_SECRET=

# --- Storage ---
# Where the semantic index and caches live. Defaults to an OS-appropriate data dir.
# ZOTEUS_DATA_DIR=

# --- Ops / production (M13) ---
# Structured logs for aggregation (text for local dev). Never logs tokens/keys/passcode.
ZOTEUS_LOG_FORMAT=text          # text | json
# Also append every log line to this file (same format). For a server run by a scheduled
# task or a service manager that discards stderr, the only record of what it was doing.
# ZOTEUS_LOG_FILE=
# Expose the /metrics counter endpoint. Open unless ZOTEUS_METRICS_TOKEN is set, so on a
# reachable deployment set the token, block the path at your proxy, or both.
ZOTEUS_METRICS_ENABLED=false
# Bearer token demanded by /metrics and /usage.json. Unset leaves both open.
# ZOTEUS_METRICS_TOKEN=
# Keep a usage log in <data dir>/usage.sqlite: one row per tool call and request, with
# tool names, outcomes and durations. Off by default, and it never leaves this machine:
# nothing is sent anywhere, and there is no endpoint that serves it without the token
# above. Argument VALUES are never recorded, only which arguments were given and how big
# they were, so a search string cannot be reconstructed from it.
ZOTEUS_USAGE_LOG=false
# Days of raw events kept. Daily per-tool, per-user totals are kept indefinitely (~1 KB/day).
ZOTEUS_USAGE_RETENTION_DAYS=30
# How a caller is recorded: their Zotero user id, a salted hash of it, or not at all.
ZOTEUS_USAGE_IDENTIFY=user      # user | hash | none
# /readyz pings the Zotero API (HEAD) to report upstream reachability.
ZOTEUS_READYZ_CHECK_ZOTERO=true
# Per-IP rate limit on /mcp (keyed on the real client IP behind the proxy). 0 disables.
ZOTEUS_MCP_RATE_LIMIT_WINDOW_SEC=60
ZOTEUS_MCP_RATE_LIMIT_MAX=120
# The public hostname Caddy serves (used by deploy/Caddyfile).
ZOTEUS_DOMAIN=

# --- Connector directory / CIMD (M14) ---
# Resolve a URL client_id to a Client ID Metadata Document (single shared app, no per-connection DCR).
# Required to list the hosted connector in the claude.ai directory.
ZOTEUS_CIMD_ENABLED=false
# How long a fetched CIMD document is cached (seconds).
ZOTEUS_CIMD_CACHE_TTL_SEC=3600
# Max bytes accepted for a CIMD document.
ZOTEUS_CIMD_MAX_BYTES=16384
# Allowed redirect_uri schemes in a CIMD document (comma-separated).
ZOTEUS_CIMD_ALLOWED_REDIRECT_SCHEMES=https
# SSRF guard: restrict CIMD client_id hosts to this allowlist (comma-separated; exact or .suffix
# match). Empty = any PUBLIC host (private/loopback/link-local/reserved IPs are always rejected).
# For a directory connector, set this to the directory host, e.g. claude.ai
ZOTEUS_CIMD_ALLOWED_HOSTS=
