# Dependencies
# Matches the directory and, deliberately, a symlink of the same name: a trailing
# slash matches only a directory, so a symlink called node_modules slipped past it
# once and was committed by `git add -A`.
node_modules
.pnp.*
.yarn/*

# Build output
dist/
build/
*.tsbuildinfo

# Claude Desktop bundles staged and packed by scripts/mcpb-bundle.ts
mcpb-build/
*.mcpb

# Test / coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets
.env
.env.*
!.env.example
# mcp-publisher login credentials (registry/github tokens) — never commit
.mcpregistry_*

# Zoteus runtime data (semantic index, caches)
.zoteus/
data/
*.sqlite
*.sqlite-*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Internal planning artifacts (superpowers specs/plans/handoff briefs) — kept local, not published
docs/superpowers/

# Working notes and drafts: local only, never published.
.claude/drafts/

# Local agent workspaces and desktop task state are not release artifacts.
.claude/worktrees/
.claude/launch.json
.claude/scheduled_tasks.lock
